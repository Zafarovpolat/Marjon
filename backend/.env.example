# IMPORTANT: keep this file ASCII-only.
# slowapi/starlette read .env with the system locale codec (cp1252/cp1251),
# so any non-ASCII character here breaks backend startup with UnicodeDecodeError.

# --- Database -------------------------------------------------
# Local Docker (docker-compose):
DATABASE_URL=postgresql+asyncpg://marjon:marjon_secret@localhost:5432/marjon

# Neon (remote, SSL auto-enabled):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# SQLite fallback (dev only, no DB server needed):
# DATABASE_URL=sqlite+aiosqlite:///./app.db

# --- Security -------------------------------------------------
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
DEBUG=true

# --- Server ---------------------------------------------------
# PORT=8000  # Render sets this automatically

# --- Redis (optional) -----------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- CORS -----------------------------------------------------
# Add your frontend URL here. For LAN testing the launcher passes
# ALLOWED_ORIGINS as an environment variable automatically.
# ALLOWED_ORIGINS=["http://localhost:5173","https://marjon.vercel.app"]

# --- HQ admin integrations (optional) -------------------------
# DEVENT_BASE_URL=https://devent.example.com/api
# DEVENT_API_KEY=secret

# --- Payment webhooks / storage (optional) --------------------
# WEBHOOK_SECRET=shared-secret-for-payment-gateways
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=marjon
# MINIO_SECRET_KEY=marjon_secret
