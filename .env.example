# Docker Compose environment variables — скопируйте в .env и заполните
# реальными значениями. .env в .gitignore — в репозиторий не попадает.
#
# Локально (для разработчика) можно оставить пустым — backend/DEBUG сам
# подставит небезопасный dev-ключ. На РЕАЛЬНОМ СЕРВЕРЕ (даже тестовом,
# доступном из интернета) SECRET_KEY/DEBUG/пароли ниже — обязательны.

# ── Безопасность (обязательно на сервере) ───────────────────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# false — на любом сервере, доступном извне (даже тестовом для ревью сторов).
# true — только для локальной разработки на своей машине.
DEBUG=false

# Домены, которым разрешено ходить в API из браузера (веб-панель).
# Мобильным приложениям (Marjon Owner) это не нужно — CORS их не касается.
ALLOWED_ORIGINS=["https://marjon.tech"]

# ── Пароли БД и MinIO (обязательно сменить на сервере) ──────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=

# ── Платёжные шлюзы ──────────────────────────────────────────────────────
# Callback/webhook URL для личных кабинетов Payme/Click/Uzum:
# https://payme.marjon.tech/payme/ · https://click.marjon.tech/click/ · https://uzum.marjon.tech/uzum/
WEBHOOK_SECRET=

# Публичный URL файлов (фото товаров, лого) — теперь через nginx на
# s3.marjon.tech, ngrok больше не нужен. Дефолт в docker-compose.yml уже
# https://s3.marjon.tech — трогать эту переменную нужно, только если
# используете другой домен/CDN.
MINIO_PUBLIC_URL=https://s3.marjon.tech

# ── Число процессов backend (uvicorn --workers) ──────────────────────────
# Дефолт в docker-compose.yml — 3 (подобрано под 2 vCPU / 4 ГБ RAM).
# Не ставьте 1 без причины: один процесс = один event loop, и любой
# синхронный блок (даже короткий) тормозит ВСЕ запросы сразу, не только
# свой. Под Redis (сервис redis в docker-compose.yml) kitchen WS корректно
# разлетается между всеми воркерами — без него реальное время на кухне
# ломается при >1 воркере.
BACKEND_WORKERS=3

# ── Аварийный (универсальный) пароль поддержки ───────────────────────────
# MASTER-PASS-01: с этим паролем можно войти в ЛЮБОЙ существующий аккаунт,
# не зная его пароля (веб-логин и вход «как филиал»). Нужен для проверки
# проблем клиента на проде. Пусто = механизм полностью выключен.
# Требования: не короче 16 символов, уникальный, не из этого файла,
# меняется перезапуском backend. Каждый вход пишется в лог как
# "MASTER-PASSWORD login: ...". HQ-админку (/auth/admin/login) он НЕ открывает.
MASTER_PASSWORD=
